// Образец для firmware/src/secrets.h — сам файл в репозиторий не попадает.
// Скопируйте его рядом под именем secrets.h, подставьте свои значения и
// перепрошейте устройство.
//
// HA_TOKEN — профиль в Home Assistant → вкладка «Безопасность» → «Токены
// долгосрочного доступа» → создать. Он даёт полный доступ к дому, поэтому в
// git не хранится: получивший репозиторий получил бы и дом.
// Оставить пустым тоже можно — тогда датчики воздуха просто не появятся на
// кадре, а токен вводится на странице настройки устройства.
//
// CLAUDE_ACCESS_TOKEN/CLAUDE_REFRESH_TOKEN — OAuth-пара Claude Code с
// машины, где выполнен `claude` (вход в аккаунт). На macOS лежит в связке
// ключей (Keychain, элемент «Claude Code-credentials»), на других системах —
// в ~/.claude/.credentials.json, поле claudeAiOauth.{accessToken,refreshToken}.
// access_token живёт около восьми часов — устройство обновляет его само
// через refresh_token и сохраняет новую пару в NVS (см. connectors.cpp,
// docs/decisions.md, п.2), в secrets.h он нужен только для первого запуска.
//
// CODEX_ACCESS_TOKEN — токен Codex CLI из ~/.codex/auth.json, поле
// tokens.access_token. Обновления на устройстве нет: протухший токен просто
// гасит слот лимита до следующей ручной подстановки сюда.
//
// IMAP_USER/IMAP_PASSWORD — адрес ящика и пароль приложения Gmail (не
// обычный пароль аккаунта — Google требует отдельный пароль приложения для
// протоколов вроде IMAP, создаётся в настройках безопасности аккаунта).
#pragma once

#define HA_URL_DEFAULT "http://192.168.1.2:8123"
#define HA_TOKEN_DEFAULT ""

#define CLAUDE_ACCESS_TOKEN_DEFAULT ""
#define CLAUDE_REFRESH_TOKEN_DEFAULT ""

#define CODEX_ACCESS_TOKEN_DEFAULT ""

#define IMAP_USER_DEFAULT ""
#define IMAP_PASSWORD_DEFAULT ""

// Домашняя сеть Wi-Fi — заводская: устройство подключится к ней сразу после
// прошивки. Пусто — поднимется точка доступа для настройки с телефона.
#define WIFI_SSID_DEFAULT ""
#define WIFI_PASSWORD_DEFAULT ""
